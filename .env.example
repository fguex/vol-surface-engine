POSTGRES_PASSWORD=change_me

# Notifications du Mac mini (ops/mini-alerte.sh).
# Un topic ntfy est un identifiant, pas un compte : quiconque le connait peut
# LIRE et ECRIRE dessus. Long et aleatoire, et nulle part ailleurs qu'ici.
# Generer : python3 -c "import secrets; print('vse-' + secrets.token_hex(9))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
