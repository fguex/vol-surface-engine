{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tirer les donnees (2 jours)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pull_dev.py",
      "args": [
        "--jours",
        "2"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest : fichier courant",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "${file}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
